# Build outputs
# ===========================
dist/
dist-ssr/
build/
*.local

# ===========================
# Environment & Secrets - NEVER COMMIT
# ===========================
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.*
!backend/.env.example

